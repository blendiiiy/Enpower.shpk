# MySQL — forma e kontaktit ruan mesazhet këtu
# 1. Krijo databazën (p.sh. En-power.shpk) në phpMyAdmin / MySQL
# 2. Ekzekuto: npm run db:init   OSE SQL nga database/schema.sql
# 3. Vendos këto variabla:

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=En-power.shpk

# Hero video: true vetëm kur ekziston public/videos/hero.mp4
NEXT_PUBLIC_SHOW_HERO_VIDEO=

# Të dhënat në /contact (opsionale — pa to përdoren vlerat nga src/lib/site.ts)
CONTACT_PAGE_EMAIL=enpower@gmail.com
CONTACT_PAGE_PHONE=+383 44 222 836
CONTACT_PAGE_ADDRESS=Kline, Kosovë

# Resend — njoftim te ju + konfirmim te klienti (shih docs/email-resend.md)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev
